  }
 },
 {
  "name": "parser: backslash in brackets",
  "file": "internal/engine/sedscript.go",
  "old": "\t\tcase c == '\\\\' || c == '\\n':\n\t\t\treturn false\n\t\tcase c == '[' && p.i+1",
  "new": "\t\tcase c == '\\n':\n\t\t\treturn false\n\t\tcase c == '[' && p.i+1",
  "expect": "survives",
  "why": "refused rather than modelled; no misparse is known, and the GNU oracle accepts what the mutant admits",
  "run": "TestMustNotAllow|TestSedScriptAgainstGNUSandbox",
  "env": {
   "SED_ORACLE": "1"
  }
